# サプライチェーン攻撃対策: 公開から 14 日未満のバージョンを解決対象から除外する (npm 11.19 以降)
min-release-age=14

# 2026-10 security update: allow the pinned Next.js 16.4.2 release and its paired packages.
min-release-age-exclude[]=next
min-release-age-exclude[]=eslint-config-next
min-release-age-exclude[]=@next/env
min-release-age-exclude[]=@next/eslint-plugin-next
min-release-age-exclude[]=@next/swc-*
